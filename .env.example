# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/matchmind?schema=public"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Redis (for job queues and caching)
REDIS_URL="redis://localhost:6379"

# AWS S3
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="matchmind-storage"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="MatchMind <noreply@matchmind.co.il>"

# Monitoring (optional)
SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MatchMind"
